{
  "rules": {
    "machines": {
      "red-blue-01": {
        "control": {
          ".read": true,
          ".write": true,
          "up": { ".validate": "newData.isBoolean()" },
          "down": { ".validate": "newData.isBoolean()" },
          "left": { ".validate": "newData.isBoolean()" },
          "right": { ".validate": "newData.isBoolean()" },
          "dropCommand": { ".validate": "newData.isNumber()" },
          "openCommand": { ".validate": "newData.isNumber()" },
          "startCommand": { ".validate": "newData.isNumber()" },
          "gameEndsAt": {
            ".validate": "newData.isNumber() && (newData.val() === data.val() || !data.exists() || data.val() <= now || newData.val() < data.val())"
          },
          "activeControllerId": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
